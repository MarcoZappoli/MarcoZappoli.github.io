---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;
---
<a class="card" href={`/projects/${project.id}/`}>
  <div class="thumb">
    {d.cover ? <Image src={d.cover} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 400px" /> : <div class="ph" />}
  </div>
  <p class="eyebrow">{d.category} · {d.year}</p>
  <h3>{d.title}</h3>
  <p class="sum">{d.summary}</p>
</a>
<style>
  .card { display: block; color: var(--ink); }
  .card:hover { text-decoration: none; }
  .card:hover h3 { color: var(--accent); }
  .thumb { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 6px; background: #fff; border: 1px solid var(--rule); margin-bottom: 14px; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .card:hover .thumb :global(img) { transform: scale(1.03); }
  .ph { width: 100%; height: 100%; background: linear-gradient(135deg, var(--accent), var(--bg)); opacity: 0.35; }
  h3 { font-size: 21px; margin: 6px 0 8px; }
  .sum { color: var(--muted); font-size: 15.5px; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
