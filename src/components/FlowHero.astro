---
/*
 * Home-page hero: passive tracers and inertial particles in the time-periodic
 * double gyre (Shadden, Lekien & Marsden 2005), domain [0, 2] x [0, 1].
 *
 *   psi = A sin(pi f(x,t)) sin(pi y),  f = a x^2 + b x,
 *   a = eps sin(omega t),  b = 1 - 2 eps sin(omega t)
 *
 * Tracers move with the fluid:   dx/dt = u(x, t)
 * Inertial particles (minimal Maxey-Riley, Stokes drag only, heavy particles):
 *   dv/dt = (u(x, t) - v) / St,   dx/dt = v
 * The drag term is integrated exactly over each step (exponential integrator),
 * which stays stable for any St and dt:  v <- u + (v - u) exp(-dt / St).
 *
 * Edit the values below; the caption under the hero updates automatically.
 */
const params = {
  A: 1.0, // flow amplitude (speed)
  eps: 1, // oscillation of the gyre boundary; 0 = steady flow
  period: 2, // oscillation period, omega = 2 pi / period
  St: 1, // Stokes number, St = tau_p / T_flow with tau_p = 2 rho_p r^2 / (9 rho_f nu)
  R: 0.001, // density ratio rho_p / rho_f (1000 heavy, 1 neutrally buoyant, < 1 bubbles)
  nTracers: 5000, // passive tracers (drawn in the muted colour)
  nInertial: 15000, // inertial particles (drawn in the accent colour)
  dt: 0.002, // time step per animation frame
  reseed: 0.002, // probability per frame that a particle restarts at a random point
  dotTracer: 0.7, // dot size in px
  dotInertial: 0.5,
  tracerAlpha: 1.0, // tracer opacity, so the inertial particles stand out
};
const { A, eps, period, St, R } = params;
---
<canvas id="flow" aria-hidden="true"></canvas>
<p class="eyebrow flow-caption">
  Live: double gyre, A = {A}, ε = {eps}, ω = 2π/{period} ·
  <span class="key tracer"></span> tracers ·
  <span class="key inertial"></span> inertial particles, St = {St}, ρp/ρf = {R}
</p>
<script define:vars={{ params }}>
  const c = document.getElementById('flow');
  const g = c.getContext('2d');
  const { A, eps, period, St, nTracers, nInertial, dt, reseed, dotTracer, dotInertial, tracerAlpha, R } = params;
  const om = (2 * Math.PI) / period;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, t = 0;

  function vel(x, y, t) {
    const s = Math.sin(om * t), a = eps * s, b = 1 - 2 * eps * s;
    const f = a * x * x + b * x, fx = 2 * a * x + b;
    return [
      -Math.PI * A * Math.sin(Math.PI * f) * Math.cos(Math.PI * y),
      Math.PI * A * Math.cos(Math.PI * f) * Math.sin(Math.PI * y) * fx,
    ];
  }
  // Each particle: [x, y, vx, vy]; inertial particles start at the local fluid velocity.
  function spawn() {
    const x = Math.random() * 2, y = Math.random();
    const [u, v] = vel(x, y, t);
    return [x, y, u, v];
  }
  const tracers = Array.from({ length: nTracers }, spawn);
  const inertial = Array.from({ length: nInertial }, spawn);
  // Maxey-Riley with drag, pressure gradient and added mass:
  //   dv/dt = (u - v) / St_eff + beta Du/Dt
  //   beta = 3 / (1 + 2R),  St_eff = St (1 + 1/(2R))
  const beta = 3 / (1 + 2 * R);
  const StEff = St * (1 + 1 / (2 * R));
  const decay = Math.exp(-dt / StEff);
  // Material derivative of the fluid velocity, Du/Dt = du/dt + (u . grad) u, by central differences.
  function accel(x, y, t) {
    const h = 1e-4;
    const [u, v] = vel(x, y, t);
    const [uxp, vxp] = vel(x + h, y, t), [uxm, vxm] = vel(x - h, y, t);
    const [uyp, vyp] = vel(x, y + h, t), [uym, vym] = vel(x, y - h, t);
    const [utp, vtp] = vel(x, y, t + h), [utm, vtm] = vel(x, y, t - h);
    return [
      (utp - utm) / (2 * h) + u * (uxp - uxm) / (2 * h) + v * (uyp - uym) / (2 * h),
      (vtp - vtm) / (2 * h) + u * (vxp - vxm) / (2 * h) + v * (vyp - vym) / (2 * h),
    ];
  }

  function size() {
    const d = devicePixelRatio || 1;
    W = c.clientWidth; H = c.clientHeight;
    c.width = W * d; c.height = H * d;
    g.setTransform(d, 0, 0, d, 0, 0);
  }
  function inside(p) { return p[0] >= 0 && p[0] <= 2 && p[1] >= 0 && p[1] <= 1; }

  function rk4(x, y, t, h) {
  const [k1u, k1v] = vel(x, y, t);
  const [k2u, k2v] = vel(x + 0.5*h*k1u, y + 0.5*h*k1v, t + 0.5*h);
  const [k3u, k3v] = vel(x + 0.5*h*k2u, y + 0.5*h*k2v, t + 0.5*h);
  const [k4u, k4v] = vel(x + h*k3u, y + h*k3v, t + h);
  return [x + h/6*(k1u + 2*k2u + 2*k3u + k4u),
          y + h/6*(k1v + 2*k2v + 2*k3v + k4v)];
}

  function step() {
    const css = getComputedStyle(document.documentElement);
    g.fillStyle = css.getPropertyValue('--hero-fade');
    g.fillRect(0, 0, W, H);

    g.fillStyle = css.getPropertyValue('--flow-tracer');
    g.globalAlpha = tracerAlpha;
    for (let i = 0; i < tracers.length; i++) {
      const p = tracers[i];
      const [u, v] = vel(p[0], p[1], t);
      [p[0], p[1]] = rk4(p[0], p[1], t, dt);
      if (Math.random() < reseed || !inside(p)) tracers[i] = spawn();
      g.fillRect((p[0] / 2) * W, (1 - p[1]) * H, dotTracer, dotTracer);
    }

    g.globalAlpha = 1;
    g.fillStyle = css.getPropertyValue('--flow-inertial');
    for (let i = 0; i < inertial.length; i++) {
      const p = inertial[i];
      const [u, v] = vel(p[0], p[1], t);
      const [ax, ay] = accel(p[0], p[1], t);
      // exact step for fixed u and Du/Dt: v relaxes towards u + beta St_eff Du/Dt
      const vx = u + beta * StEff * ax, vy = v + beta * StEff * ay;
      const ox = p[2], oy = p[3];
      p[2] = vx + (p[2] - vx) * decay;
      p[3] = vy + (p[3] - vy) * decay;
      p[0] += 0.5 * (ox + p[2]) * dt; p[1] += 0.5 * (oy + p[3]) * dt;
      if (Math.random() < reseed || !inside(p)) inertial[i] = spawn();
      g.fillRect((p[0] / 2) * W, (1 - p[1]) * H, dotInertial, dotInertial);
    }

    t += dt;
    if (!reduce) requestAnimationFrame(step);
  }

  size();
  addEventListener('resize', size);
  if (reduce) { for (let i = 0; i < 600; i++) step(); } else step();
</script>
<style>
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .flow-caption { text-transform: none; letter-spacing: 0.03em; position: absolute; bottom: 16px; right: var(--gutter); font-size: 11px; max-width: calc(100% - 2 * var(--gutter)); text-align: right; z-index: 1; }
  .key { display: inline-block; width: 8px; height: 8px; border-radius: 50%; vertical-align: middle; margin-left: 4px; }
  .key.tracer { background: var(--flow-tracer); }
  .key.inertial { background: var(--flow-inertial); }
</style>
