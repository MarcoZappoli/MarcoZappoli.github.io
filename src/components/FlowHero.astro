<canvas id="flow" aria-hidden="true"></canvas>
<script>
  // Tracers in the time-periodic double gyre, a standard LCS benchmark (Shadden et al. 2005)
  const c = document.getElementById('flow') as HTMLCanvasElement;
  const g = c.getContext('2d')!;
  const A = 0.1, eps = 0.25, om = (2 * Math.PI) / 10;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let W = 0, H = 0, t = 0;
  const N = 2600;
  const P = Array.from({ length: N }, () => [Math.random() * 2, Math.random()]);
  function size() { const d = devicePixelRatio || 1; W = c.clientWidth; H = c.clientHeight; c.width = W * d; c.height = H * d; g.setTransform(d, 0, 0, d, 0, 0); }
  function vel(x: number, y: number, t: number) {
    const a = eps * Math.sin(om * t), b = 1 - 2 * eps * Math.sin(om * t);
    const f = a * x * x + b * x, fx = 2 * a * x + b;
    return [-Math.PI * A * Math.sin(Math.PI * f) * Math.cos(Math.PI * y),
             Math.PI * A * Math.cos(Math.PI * f) * Math.sin(Math.PI * y) * fx];
  }
  function step() {
    const css = getComputedStyle(document.documentElement);
    g.fillStyle = css.getPropertyValue('--hero-fade'); g.fillRect(0, 0, W, H);
    g.fillStyle = css.getPropertyValue('--accent');
    const dt = 0.06;
    for (const p of P) {
      const [u, v] = vel(p[0], p[1], t);
      p[0] += u * dt; p[1] += v * dt;
      if (Math.random() < 0.002) { p[0] = Math.random() * 2; p[1] = Math.random(); }
      g.fillRect((p[0] / 2) * W, (1 - p[1]) * H, 1.3, 1.3);
    }
    t += dt;
    if (!reduce) requestAnimationFrame(step);
  }
  size(); addEventListener('resize', size);
  if (reduce) { for (let i = 0; i < 400; i++) step(); } else step();
</script>
<style>
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>
