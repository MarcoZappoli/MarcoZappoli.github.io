---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const facts = [['Type', d.type], ['Field', d.field], ['Methods', d.tools], ['Year', String(d.year)]];
---
<Base title={d.title} description={d.summary}>
  <article>
    <header class="wrap head">
      <p class="eyebrow"><a href="/projects/">Projects</a> · {d.category}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <dl class="facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="actions">
        {d.repo && <a class="btn" href={d.repo}>Code repository</a>}
        {d.paper && <a class="btn" href={`/publications/#${d.paper}`}>Related publication</a>}
        {d.report && <a class="btn" href={d.report}>Technical report (PDF)</a>}
      </p>
    </header>
    {d.cover && (
      <div class="wrap cover"><Image src={d.cover} alt="" widths={[800, 1400]} sizes="(max-width: 1200px) 100vw, 1100px" loading="eager" /></div>
    )}
    <div class="wrap"><div class="prose"><Content /></div></div>
  </article>
</Base>
<style>
  .head { padding: 64px var(--gutter) 24px; }
  h1 { font-size: clamp(32px, 4.6vw, 56px); margin: 10px 0 16px; max-width: 24ch; }
  .lead { font-size: 19px; color: var(--muted); max-width: 66ch; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 16px 0; margin: 28px 0 0; max-width: 860px; }
  dt { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); }
  dd { margin: 2px 0 0; font-weight: 500; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
  .cover { margin: 16px auto 8px; }
  .cover :global(img) { width: 100%; max-height: 560px; object-fit: contain; border-radius: 6px; }
</style>
