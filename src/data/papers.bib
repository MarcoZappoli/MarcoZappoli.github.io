@article{zappoli2026clustering,
  title    = {Clustering and preferential sampling of particles in homogeneous shear turbulence},
  author   = {Zappoli, Marco and Quadrio, Maurizio and Chiarini, Alessandro},
  journal  = {Journal of Fluid Mechanics},
  year     = {2026},
  status   = {submitted},
  selected = {true},
  abstract = {We employ direct numerical simulation to study the clustering and preferential sampling of inertial particles in homogeneous shear turbulence at a Taylor-scale Reynolds number $Re_\lambda \approx 48$ and a Corrsin shear parameter $S^* \approx 6.75$. The particles obey the complete Maxey--Riley--Gatignol equation, including the Basset history force and Fax\'en corrections, over a wide range of density ratios ($\varrho \in [1, 100]$) and Stokes numbers ($St_\eta \in [0.1, 10]$). We show that the effect of mean shear on the dispersed phase depends on the density ratio. The intrinsic cluster geometry, such as size-distribution scaling and three-dimensional shape, is insensitive to dispersed-phase parameters and mean shear, consistent with isotropic turbulence. However, large-scale shear controls the orientation of clusters, which reflects how particles sample the local flow topology. Driven by the classical centrifugal mechanism, heavy particles ($\varrho > 1$) are expelled from vortical regions, forming clusters aligned with the inclined coherent structures of the flow. In contrast, neutrally buoyant particles ($\varrho = 1$) undergo a topological inversion: an instability of their slip velocity in strain-dominated regions, mediated by the fluid pressure gradient, drives them into vortical regions, where they form streamwise-aligned aggregates. Finally, companion simulations show that the Basset history force significantly modulates the intensity of preferential concentration. However, at $St_\eta = O(1)$ its omission leaves the cluster geometry, orientation and topological preferences unchanged, indicating that hydrodynamic memory dictates how strongly particles respond to the flow, rather than which flow topologies organise them.}
}

